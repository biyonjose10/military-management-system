# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Real secrets never land in the repo; the template does, because a
# checkout with no .env.example gives no clue which two Neon URLs are needed.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local PGlite database files. `npm run db:up` recreates them; `npm run db:seed`
# refills them. Never committed — they are a build artefact, not source.
/.pglite

# Playwright output. Regenerated on every run; the report is uploaded as a CI
# artifact on failure rather than committed.
/test-results
/playwright-report
