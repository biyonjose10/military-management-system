# Copy to .env.local and fill in. .env* is gitignored; nothing here is a real secret.

# --- Neon Postgres -----------------------------------------------------------
# Two URLs from the same Neon project, both on the Connection Details panel.
#
# DATABASE_URL is the POOLED one — its host contains "-pooler". The app uses it,
# because serverless invocations open more connections than Postgres accepts
# directly. connect_timeout=15 absorbs the cold start after Neon's free tier
# scales the compute to zero; without it the first request after an idle period
# looks like a hard connection failure.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# DIRECT_URL is the UNPOOLED one — same host without "-pooler". Migrations and
# the seed use it, because the schema engine needs session-level state that
# PgBouncer's transaction mode cannot hold.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth --------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET="replace-me"

# Required in production; NextAuth infers it locally.
# AUTH_URL="https://mms.example.com"
